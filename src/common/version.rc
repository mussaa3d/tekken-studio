// The version Windows shows in a file's properties, for the launcher and the mod alike.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "tekken8mvm: cinematic tools for Tekken 8 replays"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "ProductName", "tekken8mvm"
            VALUE "ProductVersion", "0.1"
            VALUE "LegalCopyright", "GPL-3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
